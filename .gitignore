# DEPLOY TO: .gitignore

# dependencies
node_modules/

# Next.js build output
.next/
out/

# Prisma — the generated client is derived from schema.prisma at build
# time (see package.json's postinstall/build scripts); committing it risks
# exactly the stale-client class of bug this file was added to prevent.
# prisma/migrations/ is intentionally NOT ignored — that's real history.
node_modules/.prisma/
prisma/generated/

# environment / secrets — never commit real credentials
.env
.env.local
.env*.local

# OS / editor
.DS_Store
*.pem
.vscode/
.idea/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel
